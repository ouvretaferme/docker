/log/
.DS_Store
.idea/
docker/php.sock
docker/mysql/tmp/*
src/
docker/php-fpm/tmp/*
docker/php-fpm/otf-storage

# Authentification du CLI Stripe (`stripe login`) + cache des plugins téléchargés.
# Contient une clé secrète de test (sk_test_...) : le dossier est monté sur
# /root/.config/stripe pour survivre aux recréations du conteneur, jamais versionné.
docker/php-fpm/stripe-config/*
!docker/php-fpm/stripe-config/.gitkeep

# Données applicatives des conteneurs (dumps anonymisés, datadir MySQL)
docker/mysql/*.tar.gz
docker/mysql/var/

# Copie anonymisée des sauvegardes (export-anon.sh, import-anon.sh) : les clés publiques des
# destinataires et des signataires et les réglages du poste, dont le mot de passe de dev, restent sur
# le poste.
docker/mysql/anon/destinataires/*
!docker/mysql/anon/destinataires/.gitkeep
docker/mysql/anon/signataires/*
!docker/mysql/anon/signataires/.gitkeep
docker/mysql/anon.conf
